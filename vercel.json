{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "usfinwise.com"
        }
      ],
      "destination": "https://www.usfinwise.com/:path*",
      "permanent": true
    },
    {
      "source": "/apple-app-site-association",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "destination": "/",
      "permanent": true
    }
  ]
}